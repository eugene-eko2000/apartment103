# Copy to .env.local for local development.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Stripe test-mode publishable key (safe to expose to the browser — it only
# lets Stripe.js collect card details, never move money on its own).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# OAuth Client ID (Web application) from a Google Cloud project with the
# "Google Photos Picker API" enabled, used by the admin Photos panel's
# "Import from Google Photos" button. Safe to expose to the browser — it
# only identifies the app to Google's consent screen. Leave unset to hide
# the button. Setup: console.cloud.google.com -> APIs & Services -> enable
# "Google Photos Picker API" -> Credentials -> Create OAuth client ID (Web
# application) -> add this app's origin(s) under "Authorized JavaScript
# origins" -> configure the OAuth consent screen with the
# photospicker.mediaitems.readonly scope.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google Maps Platform. Both are required for the Location view's map;
# with either unset it falls back to a static card + Google Maps link.
# The key is public (visible in the script URL) — restrict it by HTTP
# referrer in Google Cloud. The Map ID is required by Advanced Markers.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
