# Templated by nginx's docker-entrypoint (envsubst) at container start using
# FRONTEND_DOMAIN / API_DOMAIN from the environment — see docker-compose.yml.
# Rendered to /etc/nginx/conf.d/default.conf.
#
# This nginx does the frontend/API split for ONE environment and nothing else.
# TLS and the plain-HTTP -> HTTPS redirect live in the shared edge proxy
# (deploy/edge/), which terminates TLS for all four hostnames and forwards
# here over plain HTTP with the Host header intact — so the server_name blocks
# below still key off the real hostname. See
# docs/single-host-deployment-proposal.md.

# The edge proxy is the only thing that talks to us, from the Docker bridge
# range; trust its X-Forwarded-For so $remote_addr is the real client.
set_real_ip_from 172.16.0.0/12;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

server {
    listen 80;
    server_name ${FRONTEND_DOMAIN};

    location / {
        proxy_pass http://frontend:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name ${API_DOMAIN};

    # Uploaded image files, written by the backend to the shared image_data
    # volume. Served directly by nginx instead of proxying through
    # FastAPI/Mongo — keys are immutable (a fresh key per upload, see
    # app/models/image.py), so long-lived caching here is always safe.
    #
    # Regex-anchored to a single, dotted path segment (the flat, slash-free
    # key, which always has a file extension — see upload_image() in
    # app/api/routes/images.py) so it matches only "/images/<key>" and never
    # shadows the backend's own single-segment routes that have no extension,
    # e.g. "POST /images/reorder" or "DELETE /images/{image_id}", nor its
    # multi-segment routes (e.g. "/images/{id}/labels",
    # "/images/labels/{label}"). A plain "/images/" prefix match used to
    # swallow those too, returning a bare nginx 404/405 before the request
    # ever reached FastAPI.
    location ~ ^/images/([^/.]+\.[^/.]+)$ {
        alias /data/images/$1;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        # Matches the raw upload cap in app/api/routes/images.py
        # (_MAX_UPLOAD_BYTES) — nginx's 1m default otherwise rejects image
        # uploads with 413 before the request reaches FastAPI.
        client_max_body_size 20m;
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
