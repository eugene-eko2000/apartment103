# Templated by nginx's docker-entrypoint (envsubst) at container start using
# FRONTEND_DOMAIN / API_DOMAIN / SSL_CERT_FILE / SSL_KEY_FILE from the
# environment — see docker-compose.yml. Rendered to
# /etc/nginx/conf.d/default.conf.
#
# TLS cert/key are read from /etc/nginx/certs (mounted from
# .secrets/certs/<environment>/ — see deploy/deploy.sh) and cover both
# domains as SAN entries on a single certificate.

server {
    listen 80;
    server_name ${FRONTEND_DOMAIN} ${API_DOMAIN};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${FRONTEND_DOMAIN};

    ssl_certificate     /etc/nginx/certs/${SSL_CERT_FILE};
    ssl_certificate_key /etc/nginx/certs/${SSL_KEY_FILE};
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://frontend:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${API_DOMAIN};

    ssl_certificate     /etc/nginx/certs/${SSL_CERT_FILE};
    ssl_certificate_key /etc/nginx/certs/${SSL_KEY_FILE};
    ssl_protocols TLSv1.2 TLSv1.3;

    # Uploaded image files, written by the backend to the shared image_data
    # volume. Served directly by nginx instead of proxying through
    # FastAPI/Mongo — keys are immutable (a fresh key per upload, see
    # app/models/image.py), so long-lived caching here is always safe.
    location /images/ {
        alias /data/images/;
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
