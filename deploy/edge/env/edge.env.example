# Copy to edge.env and fill in real values before deploying:
#   cp edge.env.example edge.env
#
# Non-secret config for the shared edge proxy (deploy/edge/docker-compose.yml),
# the only thing on the host that binds :80 and :443. It terminates TLS for all
# four hostnames and routes each to its environment's own nginx. Deployed with
# deploy/deploy-edge.sh.
#
# There are no secrets here: the only sensitive material the edge needs is the
# TLS private key, which is a file, not an env var — it lives in
# .secrets/certs/edge/ on the deploying machine and is scp'd (mode 600) by
# deploy-edge.sh.

PROD_FRONTEND_DOMAIN=bergseehome.ch
PROD_API_DOMAIN=api.bergseehome.ch
PREPROD_FRONTEND_DOMAIN=preprod.bergseehome.ch
PREPROD_API_DOMAIN=api-preprod.bergseehome.ch

# Cert + key filenames, resolved inside .secrets/certs/edge/ on the deploying
# machine. The certificate must cover all four names above as SAN entries — a
# *.bergseehome.ch + bergseehome.ch certificate does, since every name is
# single-level.
#
# Both currently point at the same file. Split them if preprod ever gets its
# own certificate; the config already reads them independently.
PROD_SSL_CERT_FILE=bergseehome_ch_chain.crt
PROD_SSL_KEY_FILE=bergseehome_ch.key
PREPROD_SSL_CERT_FILE=bergseehome_ch_chain.crt
PREPROD_SSL_KEY_FILE=bergseehome_ch.key
