# Copy to prod.env and fill in real values before deploying:
#   cp prod.env.example prod.env
#
# This is a plain env file for now (step 1: get the stack running).
# Step 2 will replace it with real secrets management.

### Host ports ###
BACKEND_PORT=8000
FRONTEND_PORT=3000

### Frontend — baked into the browser bundle at image build time, so the
### frontend image must be rebuilt whenever these change (see
### frontend/.env.local.example) ###
NEXT_PUBLIC_API_URL=https://api.bergseehome.ch
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

### Backend (see backend/.env.example) ###
APP_NAME=apartment103-backend
ENVIRONMENT=production
MONGO_DB=apartment103

# JSON array of allowed browser origins, e.g. ["https://bergseehome.ch"]
CORS_ALLOW_ORIGINS=["https://bergseehome.ch"]

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5

# Leave SMTP_HOST unset to log OTP emails to the container's stdout instead
# of sending them (not recommended for prod).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=no-reply@bergseehome.ch

# Stripe live-mode keys. STRIPE_PUBLISHABLE_KEY (backend) and
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY (frontend, above) should match.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
