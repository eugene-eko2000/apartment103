# Copy to prod.env and fill in real values before deploying:
#   cp prod.env.example prod.env
#
# Non-secret deployment config only. Real secrets (JWT_SECRET_KEY,
# STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PUBLISHABLE_KEY,
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY, SENDGRID_API_KEY,
# TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_MESSAGING_SERVICE_SID) live in .secrets/prod.env
# instead — see .secrets/prod.env.example.

### Host ports — BACKEND_PORT/FRONTEND_PORT are bound to 127.0.0.1 only
### (debugging access); nginx is the sole public entry point on
### HTTP_PORT/HTTPS_PORT. ###
BACKEND_PORT=8000
FRONTEND_PORT=3000
HTTP_PORT=80
HTTPS_PORT=443

### Nginx TLS reverse proxy. Cert + key files named below must be placed in
### .secrets/certs/prod/ on the deploying machine (a single certificate
### covering both domains as SAN entries) — deploy.sh copies them to the
### remote host. ###
FRONTEND_DOMAIN=bergseehome.ch
API_DOMAIN=api.bergseehome.ch
SSL_CERT_FILE=bergseehome_ch_chain.crt
SSL_KEY_FILE=bergseehome_ch.key

### Frontend — baked into the browser bundle at image build time, so the
### frontend image must be rebuilt whenever these change (see
### frontend/.env.local.example). NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY lives
### in .secrets/prod.env. ###
NEXT_PUBLIC_API_URL=https://api.bergseehome.ch

# OAuth Client ID (Web application) from a Google Cloud project with the
# "Google Photos Picker API" enabled, used by the admin Photos panel's
# "Import from Google Photos" button. Safe to expose to the browser — it
# only identifies the app to Google's consent screen. Leave unset to hide
# the button. Setup: console.cloud.google.com -> APIs & Services -> enable
# "Google Photos Picker API" -> Credentials -> Create OAuth client ID (Web
# application) -> add this app's origin(s) under "Authorized JavaScript
# origins" -> configure the OAuth consent screen with the
# photospicker.mediaitems.readonly scope.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

### Backend (see backend/.env.example) ###
APP_NAME=apartment103-backend
ENVIRONMENT=production
MONGO_DB=apartment103

# JSON array of allowed browser origins, e.g. ["https://bergseehome.ch"]
CORS_ALLOW_ORIGINS=["https://bergseehome.ch"]

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5

# Leave SENDGRID_API_KEY unset (in .secrets/prod.env) to log OTP emails to
# the container's stdout instead of sending them (not recommended for prod).
SENDGRID_FROM_ADDRESS=info@bergseehome.ch

# All Stripe keys (publishable and secret) and Twilio credentials live in
# .secrets/prod.env.

# Markup applied on top of Stripe's FX rate when converting a CHF price into
# a guest-facing non-CHF currency (see backend/app/services/currency_service.py).
# 0.06 = 6%.
COMMISSION_RATE=0.06
