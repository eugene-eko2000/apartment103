# Copy to preprod.env and fill in real values before deploying:
#   cp preprod.env.example preprod.env
#
# Non-secret deployment config only. Real secrets (JWT_SECRET_KEY,
# STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PUBLISHABLE_KEY,
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY, SMTP_PASSWORD,
# TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_MESSAGING_SERVICE_SID) live in
# .secrets/preprod.env instead — see .secrets/preprod.env.example.

### Host ports — BACKEND_PORT/FRONTEND_PORT are bound to 127.0.0.1 only
### (debugging access); nginx is the sole public entry point on
### HTTP_PORT/HTTPS_PORT. ###
BACKEND_PORT=8000
FRONTEND_PORT=3000
HTTP_PORT=80
HTTPS_PORT=443

### Nginx TLS reverse proxy. Cert + key files named below must be placed in
### .secrets/certs/preprod/ on the deploying machine (a single certificate
### covering both domains as SAN entries) — deploy.sh copies them to the
### remote host. ###
FRONTEND_DOMAIN=preprod.bergseehome.ch
API_DOMAIN=api-preprod.bergseehome.ch
SSL_CERT_FILE=bergseehome_ch_chain.crt
SSL_KEY_FILE=bergseehome_ch.key

### Frontend — baked into the browser bundle at image build time, so the
### frontend image must be rebuilt whenever these change (see
### frontend/.env.local.example). NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY lives
### in .secrets/preprod.env. ###
NEXT_PUBLIC_API_URL=https://api-preprod.bergseehome.ch

### Backend (see backend/.env.example) ###
APP_NAME=apartment103-backend
ENVIRONMENT=preprod
MONGO_DB=apartment103

# JSON array of allowed browser origins, e.g. ["https://preprod.bergseehome.ch"]
CORS_ALLOW_ORIGINS=["https://preprod.bergseehome.ch"]

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5

# Leave SMTP_HOST unset to log OTP emails to the container's stdout instead
# of sending them. SMTP_PASSWORD lives in .secrets/preprod.env.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=no-reply@bergseehome.ch

# All Stripe keys (publishable and secret) and Twilio credentials live in
# .secrets/preprod.env.
