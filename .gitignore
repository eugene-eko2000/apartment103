# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Frontend

# dependencies
frontend/node_modules
frontend/.pnp
frontend/.pnp.*
frontend/.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
frontend/coverage

# next.js
frontend/.next/
frontend/out/

# production
frontend/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.local.example

# Deploy config (non-secret; see deploy/env/*.env.example for the templates)
deploy/env/*.env

# Real deploy secrets — see .secrets/*.env.example for the templates. Never
# rsynced/scp'd to a deployment host; streamed over SSH at deploy time.
.secrets/*
!.secrets/*.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Backend

# python
backend/__pycache__/
backend/**/__pycache__/
backend/*.egg-info/
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/

# virtual environments
backend/.venv/
backend/venv/

# local image uploads (IMAGE_STORAGE_PATH default; see app/core/config.py)
backend/var/

# Evaluation results
evals
