APP_NAME=apartment103-backend
ENVIRONMENT=local

MONGO_URI=
MONGO_DB=apartment103

# Origins allowed to call the API from a browser (the Next.js frontend).
# JSON array, e.g. ["https://apartment103.example"]. Must stay unset/commented
# out rather than blank (an empty string fails JSON parsing); defaults to
# ["http://localhost:3000"] when unset.
# CORS_ALLOW_ORIGINS=["https://apartment103.example"]

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5

# Leave SMTP_HOST unset to log OTP emails to the console instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=no-reply@apartment103.example

# Stripe test-mode keys (https://dashboard.stripe.com/test/apikeys).
# STRIPE_WEBHOOK_SECRET comes from the Stripe CLI ("stripe listen --print-secret")
# or the dashboard's webhook endpoint once one is configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
