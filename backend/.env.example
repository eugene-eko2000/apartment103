APP_NAME=apartment103-backend
ENVIRONMENT=local

MONGO_URI=
MONGO_DB=apartment103

# Directory where uploaded image files are written/read. Defaults to
# var/images (relative to backend/) for local dev; the deploy compose files
# override this to /data/images, a Docker volume shared with nginx.
# IMAGE_STORAGE_PATH=var/images

# Origins allowed to call the API from a browser (the Next.js frontend).
# JSON array, e.g. ["https://apartment103.example"]. Must stay unset/commented
# out rather than blank (an empty string fails JSON parsing); defaults to
# ["http://localhost:3000"] when unset.
# CORS_ALLOW_ORIGINS=["https://apartment103.example"]

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5

# SendGrid API key for sending OTP codes and booking/payment emails
# (https://app.sendgrid.com/settings/api_keys). Leave unset to log these
# emails to the console instead of sending them.
SENDGRID_API_KEY=
SENDGRID_FROM_ADDRESS=info@bergseehome.ch

# Shown on booking/payment emails and invoice PDFs.
BUSINESS_NAME=Berg See Home
# BUSINESS_ADDRESS=

# Stripe test-mode keys (https://dashboard.stripe.com/test/apikeys).
# STRIPE_WEBHOOK_SECRET comes from the Stripe CLI ("stripe listen --print-secret")
# or the dashboard's webhook endpoint once one is configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Twilio credentials for sending OTP codes by SMS
# (https://console.twilio.com/). Leave any of these unset to log OTP SMS
# codes to the console instead of sending them.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# Markup applied on top of Stripe's FX rate when converting a CHF price into
# a guest-facing non-CHF currency (see app/services/currency_service.py).
# 0.04 = 4%.
COMMISSION_RATE=0.05
