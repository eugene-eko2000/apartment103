APP_NAME=apartment103-backend
ENVIRONMENT=local

MONGO_URI=
MONGO_DB=apartment103

# Directory where uploaded image files are written/read. Defaults to
# var/images (relative to backend/) for local dev; the deploy compose files
# override this to /data/images, a Docker volume shared with nginx.
# IMAGE_STORAGE_PATH=var/images

# Origins allowed to call the API from a browser (the Next.js frontend).
# JSON array, e.g. ["https://apartment103.example"]. Must stay unset/commented
# out rather than blank (an empty string fails JSON parsing); defaults to
# ["http://localhost:3000"] when unset.
# CORS_ALLOW_ORIGINS=["https://apartment103.example"]

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5

# SendGrid API key for sending OTP codes and booking/payment emails
# (https://app.sendgrid.com/settings/api_keys). Leave unset to log these
# emails to the console instead of sending them.
SENDGRID_API_KEY=
SENDGRID_FROM_ADDRESS=info@bergseehome.ch

# Shown on booking/payment emails and invoice PDFs.
BUSINESS_NAME=Berg See Home
# BUSINESS_ADDRESS=

# Stripe test-mode keys (https://dashboard.stripe.com/test/apikeys).
# STRIPE_WEBHOOK_SECRET comes from the Stripe CLI ("stripe listen --print-secret")
# or the dashboard's webhook endpoint once one is configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Twilio credentials for sending OTP codes by SMS
# (https://console.twilio.com/). Leave any of these unset to log OTP SMS
# codes to the console instead of sending them.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# Markup applied on top of Stripe's FX rate when converting a CHF price into
# a guest-facing non-CHF currency (see app/services/currency_service.py).
# 0.06 = 6%.
COMMISSION_RATE=0.06

# How long a booking sits in "Pending" — holding (temporarily blocking) its
# dates — before it is swept away and those dates become bookable again. The
# booking is created as soon as a guest reaches checkout, so this is the
# window they have to finish paying; it is pushed back when they reach the
# payment step. Defaults to 15 minutes.
PENDING_BOOKING_TTL_MINUTES=15

# How often the sweep job looks for expired Pending bookings. Expired ones
# are also cleared on demand whenever availability is read or claimed, so
# this only bounds how stale the public calendar can get. Defaults to 1.
PENDING_BOOKING_SWEEP_INTERVAL_MINUTES=1

# Calendar sync with Airbnb/Booking.com (iCalendar — see
# docs/calendar-sync-design.md). All optional; the defaults below are what
# the app uses when these are unset.
CALENDAR_SYNC_INTERVAL_MINUTES=30
CALENDAR_SYNC_TIMEOUT_SECONDS=30
# Right-hand side of the UIDs in the feed we publish. Any stable
# domain-shaped string; it is never resolved.
# CALENDAR_UID_DOMAIN=apartment103.example
# Optional site-wide export feed at /calendar/<token>.ics carrying every
# booking and closure — handy for subscribing a personal Google/Apple
# calendar. Each external calendar already gets its own token in the admin;
# this one is extra. The URL is the only credential an .ics consumer can
# present, so treat it like a secret (put it in .secrets/<env>.env, not
# deploy/env/<env>.env). Unset = the site-wide feed is disabled.
CALENDAR_EXPORT_TOKEN=
