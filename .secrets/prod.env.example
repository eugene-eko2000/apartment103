# Real secrets for the prod deploy. Copy to prod.env and fill in real
# values:
#   cp prod.env.example prod.env
#   chmod 600 prod.env
#
# This directory must stay mode 700 (chmod 700 .secrets). Files here are
# NEVER rsynced or scp'd to the deployment host — deploy.sh sends these
# values as `export KEY=value` lines executed by the remote shell right
# before `docker compose up`, so `docker compose` picks them up from its
# own process environment. No secrets file is ever written to the
# deployment machine's disk by our tooling.
#
# Non-secret deployment config lives in deploy/env/prod.env instead — see
# deploy/env/prod.env.example.

# Signs JWT access tokens issued after OTP verification. Generate with:
#   openssl rand -hex 32
JWT_SECRET_KEY=

# Stripe live-mode secret key + webhook signing secret
# (https://dashboard.stripe.com/apikeys).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Publishable keys — safe to expose to browsers by Stripe's own design, but
# grouped here per policy. Must match each other: STRIPE_PUBLISHABLE_KEY
# (backend) and NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY (frontend build arg,
# baked into the JS bundle — rebuild the frontend image if this changes).
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# SMTP password for sending OTP emails (pairs with SMTP_USERNAME in
# deploy/env/prod.env).
SMTP_PASSWORD=

# Twilio credentials for sending OTP codes by SMS
# (https://console.twilio.com/).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
